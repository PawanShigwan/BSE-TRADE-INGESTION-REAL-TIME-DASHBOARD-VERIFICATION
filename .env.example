# Environment Variables Template for BSE Trade Ingestion System & Dashboard
# Copy this file to .env and configure your variables accordingly.

PORT=4000
BSE_PORT=3001
BSE_API_URL=http://localhost:3001
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/bse_trades?retryWrites=true&w=majority
# Example: MONGODB_URI=mongodb+srv://myuser:mypassword@cluster0.xyz.mongodb.net/bse_trades?retryWrites=true&w=majority
CHUNK_LIMIT=500
DEFAULT_DELAY_PER_CHUNK_MS=1500
